{
  "printWidth": 120,
  "trailingComma": "none",
  "singleQuote": true,
  "plugins": ["@prettier/plugin-xml", "prettier-plugin-apex"],
  "overrides": [
    {
      "files": "**/lwc/**/*.html",
      "options": {
        "parser": "lwc"
      }
    },
    {
      "files": "*.{cmp,page,component}",
      "options": {
        "parser": "html"
      }
    },
    {
      "files": "**/*.{cls,trigger}",
      "options": {
        "parser": "apex"
      }
    },
    {
      "files": "**/*.xml",
      "options": {
        "parser": "xml"
      }
    }
  ]
}
