.hub-*

# Credentials and auth material - never commit these
.env
.env.*
!.env.example
authURL.txt
*.key
*.pem
*.p12
*.pfx
sfdx-auth-url.txt

# OS + editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local tool artifacts
.cloud-attachments/
