node_modules/

# Salesforce CLI local state (never commit org auth URLs)
.sfdx/
.sf/
.sfdev/
.localdevserver/
deploy-options.json

# Generated, org-specific metadata. The platform event subscriber config names the
# username the trigger runs as, and that username only exists in one org, so the
# setup scripts render it from config/platform-event/*.template at install time.
force-app/main/default/platformEventSubscriberConfigs/

