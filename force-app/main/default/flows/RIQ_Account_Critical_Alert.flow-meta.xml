<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Notify_Manager</name>
        <label>Notify Manager</label>
        <locationX>578</locationX>
        <locationY>458</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <connector>
            <targetReference>Post_To_Chatter</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Post_To_Chatter</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>body</name>
            <value>
                <stringValue>{!$Record.Name} dropped to Critical with a health score of {!$Record.RIQ_Health_Score__c}. Open the account and review the renewal plan.</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <elementReference>Get_Notification_Type.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>Manager_Ids</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <stringValue>Account is Critical: {!$Record.Name}</stringValue>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <name>Post_To_Chatter</name>
        <label>Post To Chatter</label>
        <locationX>798</locationX>
        <locationY>458</locationY>
        <actionName>chatterPost</actionName>
        <actionType>chatterPost</actionType>
        <faultConnector>
            <targetReference>Stop_Notification_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>subjectNameOrId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>text</name>
            <value>
                <elementReference>Chatter_Message</elementReference>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Assign_Manager</name>
        <label>Assign Manager</label>
        <locationX>358</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>Manager_Ids</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_Owner.ManagerId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Notify_Manager</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Stop_Notification_Fault</name>
        <label>Stop (Notification Fault)</label>
        <locationX>798</locationX>
        <locationY>670</locationY>
        <assignmentItems>
            <assignToReference>Skip_Reason</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Notification or Chatter post failed - swallowed so the score update still commits.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Has_Manager</name>
        <label>Has Manager?</label>
        <locationX>242</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Post_To_Chatter</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Manager</defaultConnectorLabel>
        <rules>
            <name>Manager_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Owner.ManagerId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Manager</targetReference>
            </connector>
            <label>Manager found</label>
        </rules>
    </decisions>
    <description
  >RenewalIQ: when an Account's health status changes to Critical, notify the owner's manager and post to the account feed. Deliberately declarative - see the README section on Flow vs Apex.</description>
    <interviewLabel>RIQ Account Critical Alert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RIQ Account Critical Alert</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Notification_Type</name>
        <label>Get Notification Type</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Owner</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>RIQ_HealthAlert</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Owner</name>
        <label>Get Owner</label>
        <locationX>50</locationX>
        <locationY>300</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Manager</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Notification_Type</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RIQ_Health_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Critical</stringValue>
            </value>
        </filters>
        <filters>
            <field>RIQ_Health_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>Chatter_Message</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>RenewalIQ flagged {!$Record.Name} as Critical (health score {!$Record.RIQ_Health_Score__c}, renewal {!$Record.RIQ_Contract_End_Date__c}). An executive outreach task was created for the account owner; the owner's manager is notified when one is set.</text>
    </textTemplates>
    <variables>
        <name>Manager_Ids</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>Skip_Reason</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
