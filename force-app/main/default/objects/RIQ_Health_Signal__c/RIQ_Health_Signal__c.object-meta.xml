<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowInChatterGroups>false</allowInChatterGroups>
    <deploymentStatus>Deployed</deploymentStatus>
    <description
  >Raw health evidence for an Account (escalations, usage drops, sponsor departures, payments, NPS). Inputs to the RenewalIQ scoring engine.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>Health Signal</label>
    <nameField>
        <displayFormat>RIQ-HS-{0000}</displayFormat>
        <label>Signal Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Health Signals</pluralLabel>
    <sharingModel>ControlledByParent</sharingModel>
</CustomObject>
