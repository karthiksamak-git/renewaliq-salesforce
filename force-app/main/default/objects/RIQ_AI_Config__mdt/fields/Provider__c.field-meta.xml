<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Provider__c</fullName>
    <description
  >Which OpenAI-compatible provider this configuration targets. Documentation for whoever operates the org: the endpoint itself comes from the Named Credential URL and Request Path, so switching provider stays a configuration change.</description>
    <fieldManageability>DeveloperControlled</fieldManageability>
    <label>Provider</label>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Groq</fullName>
                <default>true</default>
                <label>Groq</label>
            </value>
            <value>
                <fullName>OpenAI-compatible</fullName>
                <default>false</default>
                <label>OpenAI compatible</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
